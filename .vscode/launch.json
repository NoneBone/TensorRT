    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python 调试程序: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "py: gnn",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/samples/python/aliased_io_plugin/aliased_io_plugin.py",
            "args": [
                // "add",
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/samples/python/aliased_io_plugin/",
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
                "CUDA_VISIBLE_DEVICES": "3",
                "TORCH_ONNX_USE_LEGACY_EXPORTER": "1",
                "TORCH_LOGS": "dynamic"
            },
            "justMyCode": false,
            "redirectOutput": true,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "py: create_onnx",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/samples/python/detectron2/create_onnx.py",
            "args": [
                "--exported_onnx",
                "samples/python/detectron2/model/model.onnx",
                "--onnx",
                "samples/python/detectron2/model/converted.onnx",
                "--det2_config",
                "samples/python/detectron2/detectron2/configs/COCO-InstanceSegmentation/mask_rcnn_R_50_FPN_3x.yaml",
                "--det2_weights",
                "/root/.torch/iopath_cache/detectron2/COCO-InstanceSegmentation/mask_rcnn_R_50_FPN_3x/137849600/model_final_f10217.pkl",
                "--sample_image",
                "samples/python/detectron2/1344x1344.jpg"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}",
                "CUDA_VISIBLE_DEVICES": "0",
                "TORCH_ONNX_USE_LEGACY_EXPORTER": "1",
                "TORCH_LOGS": "dynamic"
            },
            "justMyCode": false,
            "redirectOutput": true,
            "envFile": "${workspaceFolder}/.env"
        },
        {
